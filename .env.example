# Copia este archivo a ".env" (en la raíz) y ajusta los valores según el
# entorno. Docker Compose lo lee automáticamente. Este archivo NUNCA se sube
# a git (ver .gitignore) — solo .env.example queda versionado.

# ── Backend (9 servicios: 8 microservicios + bff-gateway) ─────────────────────
# "noauth" = sin Azure, JWT no se valida, H2 embebida (demo rápida).
# Vacío ("")= valida JWT real de Azure Entra ID y usa MySQL.
SPRING_PROFILES_ACTIVE=noauth

# Solo importan cuando SPRING_PROFILES_ACTIVE no es "noauth". Reemplaza
# <TENANT_ID> por el Directory (tenant) ID real. AZURE_AUDIENCES acepta una
# lista separada por coma (el GUID del Application (client) ID del backend
# y/o su Application ID URI, p.ej. "api://cafeteria-backend") — con tokens v2
# el claim "aud" trae el GUID, no el URI (ver docs/EP2_PLAN.md sección 7).
# IMPORTANTE: el Application ID URI es el que te muestra TU App Registration
# en "Expose an API" — no asumas que es literalmente "api://cafeteria-backend",
# cópialo tal cual aparece ahí (y el GUID del client ID) o el token nunca
# calzará con la audiencia esperada.
AZURE_ISSUER_URI=https://login.microsoftonline.com/<TENANT_ID>/v2.0
AZURE_AUDIENCES=api://cafeteria-backend
# Opcional: solo necesario en tenants Microsoft Entra External ID (dominio
# *.ciamlogin.com). Si lo defines, el backend arma el JwtDecoder directamente
# desde este JWK Set en vez de descubrirlo solo vía issuer-uri (OIDC discovery),
# pero igual valida issuer + audiencias con AZURE_ISSUER_URI/AZURE_AUDIENCES.
# Formato: https://<subdominio>.ciamlogin.com/<TENANT_ID>/discovery/v2.0/keys
AZURE_JWK_SET_URI=

# ── Frontend ──────────────────────────────────────────────────────────────────
# URL base de la API (BFF). En local: http://localhost:8080/api
# En EC2: http://<IP_PUBLICA_EC2>:8080/api
VITE_API_BASE_URL=http://localhost:8080/api

# Deshabilitar autenticación Azure (true = sin login, para desarrollo/demo)
# Cambiar a false cuando Azure Entra ID esté configurado
VITE_AUTH_DISABLED=true

# Solo importan cuando VITE_AUTH_DISABLED=false. FRONTEND_CLIENT_ID = el
# Application (client) ID del App Registration SPA (no del backend).
VITE_AZURE_CLIENT_ID=<FRONTEND_CLIENT_ID>
VITE_AZURE_TENANT_ID=<TENANT_ID>
# Opcional: solo para tenants Microsoft Entra External ID (ciamlogin). Si no
# la defines, el frontend arma la authority clásica
# "https://login.microsoftonline.com/<TENANT_ID>" — en un tenant ciamlogin
# debe ser "https://<subdominio>.ciamlogin.com/" en su lugar.
VITE_AZURE_AUTHORITY=
VITE_AZURE_REDIRECT_URI=http://localhost:5180
FRONTEND_ORIGIN=http://localhost:*
VITE_API_SCOPES=api://cafeteria-backend/pedidos.read,api://cafeteria-backend/pedidos.write

# URL del panel de administracion de RabbitMQ (boton "Dashboard RabbitMQ",
# solo visible para el rol ADMIN). En EC2: http://<IP_PUBLICA_BACKEND>:15672
VITE_RABBITMQ_DASHBOARD_URL=http://localhost:15672

# ── BFF Gateway ───────────────────────────────────────────────────────────────
# Origen del frontend permitido en CORS. En local: http://localhost:4200
# En EC2: http://<IP_PUBLICA_EC2>:4200
FRONTEND_ORIGIN=http://localhost:4200

# Secreto que exige el BFF en el header "X-Origin-Verify" (ver
# docs/EP2_PLAN.md sección 8.2). Vacío en local: el filtro no exige nada.
# En EC2, Terraform (infra/terraform/apigateway.tf) genera uno y lo inyecta
# en cada petición que pasa por el API Gateway; pegarle directo al puerto
# 8080 de la EC2 sin ese header responde 403 (prueba S8).
ORIGIN_VERIFY_SECRET=

# ── Llamadas internas entre microservicios ───────────────────────────────────
# Secreto compartido que ms-inventario, ms-clientes y ms-notificaciones envian
# a ms-pedidos (header X-Internal-Token) para pedirle el detalle de un pedido
# desde sus consumidores de RabbitMQ. Cambia este valor en un despliegue real.
INTERNAL_API_TOKEN=cafeteria-interno-local

# ── Base de datos ─────────────────────────────────────────────────────────────
# Password de MySQL (usuario fijo "cafeteria"). En EC2 lo genera Terraform
# (ver infra/terraform/variables.tf, "db_password") a partir de tu
# terraform.tfvars; nunca lo dejes en el valor de ejemplo en un despliegue real.
DB_PASSWORD=cafeteria

# ── RabbitMQ (cluster de 3 nodos, ver docs/EP2_PLAN.md sección 3 / Fase 2) ─────
# Usuario/clave de los 3 nodos y de las apps que publican/consumen mensajes.
RABBITMQ_USER=cafeteria
RABBITMQ_PASSWORD=cafeteria
# Debe ser EXACTAMENTE la misma en los 3 nodos: es lo que les permite
# autenticarse entre si para formar el cluster. Cambia este valor por algo
# propio antes de desplegar (no lo dejes en el default de ejemplo).
RABBITMQ_ERLANG_COOKIE=cafeteria_erlang_cookie
