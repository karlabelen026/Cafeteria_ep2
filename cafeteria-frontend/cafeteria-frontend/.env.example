# Copia este archivo a ".env" y completa con tus datos reales de Azure Entra ID.
# Vite solo expone al navegador las variables que empiezan con VITE_.
VITE_AZURE_CLIENT_ID=<SPA_CLIENT_ID>
VITE_AZURE_TENANT_ID=<TENANT_ID>
# Opcional: solo para tenants Microsoft Entra External ID (dominio
# *.ciamlogin.com). Si no la defines, se arma la authority clásica
# "https://login.microsoftonline.com/<TENANT_ID>".
VITE_AZURE_AUTHORITY=
VITE_AZURE_REDIRECT_URI=http://localhost:4200
VITE_API_BASE_URL=http://localhost:8080/api
VITE_API_SCOPES=api://cafeteria-backend/pedidos.read,api://cafeteria-backend/pedidos.write
# Panel de administracion de RabbitMQ (boton "Dashboard RabbitMQ", solo ADMIN).
VITE_RABBITMQ_DASHBOARD_URL=http://localhost:15672

# SOLO para desarrollo local, mientras no tienes Azure Entra ID configurado
# todavia. En "true", el frontend NO llama a MSAL para nada: salta el login
# y las llamadas al backend van sin token (para que funcione, el backend
# debe estar corriendo con SPRING_PROFILES_ACTIVE=noauth). Nunca debe
# quedar en "true" en la entrega final.
VITE_AUTH_DISABLED=false
