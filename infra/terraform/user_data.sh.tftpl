#!/bin/bash
# Generado por Terraform (infra/terraform/main.tf) a partir de este template.
# Se ejecuta una sola vez al primer arranque de la EC2 (cloud-init). Deja todo
# el stack arriba solo y crea el servicio systemd que lo vuelve a levantar en
# cada arranque posterior (ver docs/EP2_PLAN.md sección 8.1: el Learner Lab
# detiene la instancia al terminar la sesión del lab).
set -euxo pipefail

APP_DIR=/opt/cafeteria
CERT_DIR=/opt/cafeteria-certs

# ── Docker + plugin de compose ──────────────────────────────────────────────
apt-get update -y
apt-get install -y ca-certificates curl gnupg git openssl

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# ── Swap de 4 GB: la t3.large compila/corre 11 JVM + Postgres + 3 nodos
# RabbitMQ; sin swap el OOM killer mata procesos durante el primer
# "docker compose build" (ver docs/EP2_PLAN.md sección 8.1). ─────────────────
if [ ! -f /swapfile ]; then
  fallocate -l 4G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

# ── Repositorio ──────────────────────────────────────────────────────────────
if [ ! -d "$APP_DIR/.git" ]; then
  rm -rf "$APP_DIR"
  git clone --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  git fetch origin "${repo_branch}"
  git checkout "${repo_branch}"
  git pull origin "${repo_branch}"
fi
chown -R ubuntu:ubuntu "$APP_DIR"

# ── Certificado autofirmado para nginx (HTTPS en 443, ver
# cafeteria-frontend/.../docker-entrypoint.sh: busca fullchain.pem/privkey.pem
# montados en /etc/nginx/certs) ───────────────────────────────────────────────
mkdir -p "$CERT_DIR"
if [ ! -f "$CERT_DIR/fullchain.pem" ]; then
  openssl req -x509 -nodes -days 825 -newkey rsa:2048 \
    -keyout "$CERT_DIR/privkey.pem" \
    -out "$CERT_DIR/fullchain.pem" \
    -subj "/CN=${eip}" \
    -addext "subjectAltName=IP:${eip}"
fi
chown -R ubuntu:ubuntu "$CERT_DIR"

# ── .env (nunca se commitea; ver .gitignore del repo) ─────────────────────────
cat > "$APP_DIR/.env" <<ENV_EOF
# Generado por Terraform (infra/terraform/user_data.sh.tftpl). No editar a
# mano: un "terraform apply" o un reinicio de la EC2 lo vuelve a generar.
SPRING_PROFILES_ACTIVE=
AZURE_ISSUER_URI=${azure_issuer_uri}
AZURE_AUDIENCES=${azure_backend_client_id},api://${azure_backend_client_id}
AZURE_JWK_SET_URI=${azure_jwk_set_uri}

VITE_API_BASE_URL=${api_gateway_url}
VITE_AUTH_DISABLED=false
VITE_AZURE_CLIENT_ID=${azure_frontend_client_id}
VITE_AZURE_TENANT_ID=${azure_tenant_id}
VITE_AZURE_AUTHORITY=${azure_authority}
VITE_AZURE_REDIRECT_URI=https://${eip}
VITE_API_SCOPES=api://${azure_backend_client_id}/pedidos.read,api://${azure_backend_client_id}/pedidos.write

FRONTEND_ORIGIN=https://${eip}
ORIGIN_VERIFY_SECRET=${origin_verify_secret}

DB_PASSWORD=${db_password}

RABBITMQ_USER=cafeteria
RABBITMQ_PASSWORD=${rabbitmq_password}
RABBITMQ_ERLANG_COOKIE=${rabbitmq_erlang_cookie}
ENV_EOF
chown ubuntu:ubuntu "$APP_DIR/.env"
chmod 600 "$APP_DIR/.env"

# ── docker-compose.override.yml: publica 443/80 y monta el certificado. El
# docker-compose.yml versionado solo publica 4200:80 para no romper el uso
# local sin HTTPS (ver ese archivo). ──────────────────────────────────────────
cat > "$APP_DIR/docker-compose.override.yml" <<COMPOSE_EOF
services:
  frontend:
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - $CERT_DIR:/etc/nginx/certs:ro
COMPOSE_EOF
chown ubuntu:ubuntu "$APP_DIR/docker-compose.override.yml"

# ── Servicio systemd: levanta el stack en cada arranque ───────────────────────
cat > /etc/systemd/system/cafeteria.service <<SERVICE_EOF
[Unit]
Description=CafeGestion360 (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/docker compose up -d --build
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE_EOF

systemctl daemon-reload
systemctl enable cafeteria.service
systemctl start cafeteria.service
