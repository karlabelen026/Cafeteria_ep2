#!/bin/bash
# Generado por Terraform (infra/terraform/main.tf, aws_instance.backend) a
# partir de este template. Se ejecuta una sola vez al primer arranque de la
# EC2 (cloud-init). Levanta MySQL + los 3 nodos RabbitMQ + los 9
# microservicios + bff-gateway (todo menos el frontend, que corre en su
# propia instancia, ver user_data_frontend.sh.tftpl) y crea el servicio
# systemd que los vuelve a levantar en cada arranque posterior (ver
# docs/EP2_PLAN.md sección 8.1: el Learner Lab detiene la instancia al
# terminar la sesión del lab).
set -euxo pipefail

APP_DIR=/opt/cafeteria

# ── Docker + plugin de compose ──────────────────────────────────────────────
apt-get update -y
apt-get install -y ca-certificates curl gnupg git

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# ── Swap de 4 GB: la t3.large compila/corre 9 JVM + bff-gateway + MySQL + 3
# nodos RabbitMQ; sin swap el OOM killer mata procesos durante el primer
# "docker compose build" (ver docs/EP2_PLAN.md sección 8.1). ─────────────────
if [ ! -f /swapfile ]; then
  fallocate -l 4G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

# ── Repositorio ──────────────────────────────────────────────────────────────
if [ ! -d "$APP_DIR/.git" ]; then
  rm -rf "$APP_DIR"
  git clone --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  git fetch origin "${repo_branch}"
  git checkout "${repo_branch}"
  git pull origin "${repo_branch}"
fi
chown -R ubuntu:ubuntu "$APP_DIR"

# ── .env (nunca se commitea; ver .gitignore del repo) ─────────────────────────
cat > "$APP_DIR/.env" <<ENV_EOF
# Generado por Terraform (infra/terraform/user_data_backend.sh.tftpl). No
# editar a mano: un "terraform apply" o un reinicio de la EC2 lo vuelve a
# generar.
SPRING_PROFILES_ACTIVE=
AZURE_ISSUER_URI=${azure_issuer_uri}
AZURE_AUDIENCES=${azure_backend_client_id},api://${azure_backend_client_id}
AZURE_JWK_SET_URI=${azure_jwk_set_uri}

# Origen permitido para CORS: la instancia de frontend (nginx), no esta misma.
FRONTEND_ORIGIN=https://${frontend_eip}
ORIGIN_VERIFY_SECRET=${origin_verify_secret}

DB_PASSWORD=${db_password}

RABBITMQ_USER=cafeteria
RABBITMQ_PASSWORD=${rabbitmq_password}
RABBITMQ_ERLANG_COOKIE=${rabbitmq_erlang_cookie}
ENV_EOF
chown ubuntu:ubuntu "$APP_DIR/.env"
chmod 600 "$APP_DIR/.env"

# ── Servicio systemd: levanta todo menos "frontend" en cada arranque ─────────
cat > /etc/systemd/system/cafeteria.service <<SERVICE_EOF
[Unit]
Description=CafeGestion360 backend (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/docker compose up -d --build mysql rabbitmq-1 rabbitmq-2 rabbitmq-3 ms-productos ms-inventario ms-pedidos ms-clientes ms-pagos ms-empleados ms-proveedores ms-reportes ms-notificaciones ms-rabbitmq-admin bff-gateway
ExecStop=/usr/bin/docker compose down
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE_EOF

systemctl daemon-reload
systemctl enable cafeteria.service
systemctl start cafeteria.service
