#!/bin/bash
# Generado por Terraform (infra/terraform/main.tf, aws_instance.backend) a
# partir de este template. Se ejecuta una sola vez al primer arranque de la
# EC2 (cloud-init). Levanta MySQL + los 13 servicios del backend con la imagen
# ya compilada en GHCR (ver deploy/aws/docker-compose.apps.yml; aqui no se
# compila nada). Kafka y RabbitMQ corren en sus propias EC2, a las que se
# llega por IP privada. Crea el servicio systemd que vuelve a levantar todo
# en cada arranque posterior (el Learner Lab detiene la instancia al
# terminar la sesión del lab).
set -euxo pipefail

APP_DIR=/opt/cafeteria

# ── Docker + plugin de compose ──────────────────────────────────────────────
apt-get update -y
apt-get install -y ca-certificates curl gnupg git netcat-openbsd

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# ── Swap de 2 GB: colchon para las 13 JVM + MySQL. Ya no hace falta mas porque
# esta EC2 no compila nada (solo pull de la imagen). ─────────────────────────
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

# ── Repositorio (antes de montar el volumen de datos: "git clone" borra y
# recrea $APP_DIR si todavia no es un repo git, y no debe hacerlo sobre un
# punto de montaje ya ocupado) ────────────────────────────────────────────────
if [ ! -d "$APP_DIR/.git" ]; then
  rm -rf "$APP_DIR"
  git clone --depth 1 --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  git fetch --depth 1 origin "${repo_branch}"
  git reset --hard FETCH_HEAD
fi
chown -R ubuntu:ubuntu "$APP_DIR"

# ── Volumen EBS de datos de MySQL (ver aws_ebs_volume.mysql_data /
# aws_volume_attachment.mysql_data en main.tf): separado del disco raiz para
# que sobreviva si esta instancia se reemplaza. En instancias Nitro (como
# t3.*) un volumen adjuntado como "/dev/sdf" aparece como /dev/nvme1n1, no
# con ese nombre logico; se espera a que el kernel lo detecte. Si ya tiene
# un filesystem (reatado a una instancia nueva, datos existentes) no se
# formatea; si esta en blanco (primer arranque de la vida del volumen) se
# formatea una sola vez. ───────────────────────────────────────────────────
DATA_DEVICE=/dev/nvme1n1
for i in $(seq 1 30); do
  [ -b "$DATA_DEVICE" ] && break
  sleep 2
done
if ! blkid "$DATA_DEVICE" >/dev/null 2>&1; then
  mkfs.ext4 "$DATA_DEVICE"
fi
mkdir -p "$APP_DIR/mysql-data"
if ! mountpoint -q "$APP_DIR/mysql-data"; then
  mount "$DATA_DEVICE" "$APP_DIR/mysql-data"
fi
chown -R 999:999 "$APP_DIR/mysql-data"
DATA_UUID=$(blkid -s UUID -o value "$DATA_DEVICE")
if ! grep -q "$DATA_UUID" /etc/fstab; then
  echo "UUID=$DATA_UUID $APP_DIR/mysql-data ext4 defaults,nofail 0 2" >> /etc/fstab
fi

# ── .env (nunca se commitea; ver .gitignore del repo) ─────────────────────────
cat > "$APP_DIR/.env" <<ENV_EOF
# Generado por Terraform (infra/terraform/user_data_backend.sh.tftpl). No
# editar a mano: un "terraform apply" lo vuelve a generar.
BACKEND_IMAGE=${backend_image}
SPRING_PROFILES_ACTIVE=
AZURE_ISSUER_URI=${azure_issuer_uri}
AZURE_AUDIENCES=${azure_backend_client_id},api://${azure_backend_client_id}
AZURE_JWK_SET_URI=${azure_jwk_set_uri}

# Origen permitido para CORS: la instancia de frontend (nginx), no esta misma.
FRONTEND_ORIGIN=https://${frontend_hostname}
ORIGIN_VERIFY_SECRET=${origin_verify_secret}
INTERNAL_API_TOKEN=${internal_api_token}

DB_PASSWORD=${db_password}

# Kafka y RabbitMQ en sus propias EC2, por IP privada (cada broker y cada
# nodo publica su propio puerto, ver deploy/aws/docker-compose.*.yml).
KAFKA_BOOTSTRAP_SERVERS=${kafka_private_ip}:9092,${kafka_private_ip}:9093,${kafka_private_ip}:9094
RABBITMQ_ADDRESSES=${rabbitmq_private_ip}:5672,${rabbitmq_private_ip}:5673,${rabbitmq_private_ip}:5674
RABBITMQ_MANAGEMENT_URL=http://${rabbitmq_private_ip}:15672
RABBITMQ_USER=cafeteria
RABBITMQ_PASSWORD=${rabbitmq_password}
ENV_EOF
chown ubuntu:ubuntu "$APP_DIR/.env"
chmod 600 "$APP_DIR/.env"

# ── Login en GHCR solo si el package es privado (ghcr_token). Sin "set -x"
# para que el token no quede en /var/log/cloud-init-output.log. ─────────────
set +x
if [ -n "${ghcr_token}" ]; then
  echo "${ghcr_token}" | docker login ghcr.io -u cafeteria --password-stdin
fi
set -x

# ── Espera a Kafka y RabbitMQ: corren en otras EC2 que arrancan en paralelo, y
# ms-antifraude (Kafka Streams) falla si arranca sin brokers. Maximo 10 min;
# si no responden, el servicio systemd falla y vuelve a intentar. ───────────
cat > /usr/local/bin/esperar-brokers.sh <<'SCRIPT_EOF'
#!/bin/bash
set -u
DESTINOS="${kafka_private_ip}:9092 ${kafka_private_ip}:9093 ${kafka_private_ip}:9094 ${rabbitmq_private_ip}:5672 ${rabbitmq_private_ip}:5673 ${rabbitmq_private_ip}:5674"
INICIO=$(date +%s)
for destino in $DESTINOS; do
  host=$${destino%:*}
  puerto=$${destino#*:}
  until nc -z -w 3 "$host" "$puerto"; do
    if [ $(( $(date +%s) - INICIO )) -ge 600 ]; then
      echo "$destino no respondio en 10 minutos" >&2
      exit 1
    fi
    sleep 5
  done
  echo "$destino disponible"
done
SCRIPT_EOF
chmod +x /usr/local/bin/esperar-brokers.sh

# ── Servicio systemd: en cada arranque espera a los brokers, baja la version
# mas reciente de la imagen y levanta MySQL + los 13 servicios (sin --build). ─
cat > /etc/systemd/system/cafeteria.service <<SERVICE_EOF
[Unit]
Description=CafeGestion360 backend (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$APP_DIR
ExecStartPre=/usr/local/bin/esperar-brokers.sh
ExecStartPre=/usr/bin/docker compose -f deploy/aws/docker-compose.apps.yml --env-file .env pull
ExecStart=/usr/bin/docker compose -f deploy/aws/docker-compose.apps.yml --env-file .env up -d
ExecStop=/usr/bin/docker compose -f deploy/aws/docker-compose.apps.yml --env-file .env down
# Si un servicio falla al arrancar, compose aborta sin crear los que faltan: reintenta.
Restart=on-failure
RestartSec=30
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE_EOF

systemctl daemon-reload
systemctl enable cafeteria.service
systemctl start cafeteria.service
