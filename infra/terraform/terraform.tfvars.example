# Copia este archivo a "terraform.tfvars" y completa tus valores reales.
# terraform.tfvars NUNCA se sube a git (ver .gitignore de este directorio).

region                    = "us-east-1"
backend_instance_type     = "t3.large"
frontend_instance_type    = "t3.micro"
backend_availability_zone = "us-east-1a"
key_name                  = "vockey"
iam_instance_profile      = "LabInstanceProfile"

# Tu IP pública (https://whatismyip.com) en formato CIDR, p.ej. "190.123.45.67/32"
my_ip_cidr = "<TU_IP>/32"

repo_url    = "https://github.com/<tu-usuario>/cafeteria.git"
repo_branch = "main"

# Ver docs/EP2_PLAN.md sección 7 / 7-bis.
azure_tenant_id          = "<TENANT_ID>"
azure_backend_client_id  = "<BACKEND_CLIENT_ID>"
azure_frontend_client_id = "<FRONTEND_CLIENT_ID>"
azure_issuer_uri         = "https://<subdominio>.ciamlogin.com/<TENANT_ID>/v2.0"
# Vacío si tu tenant NO es External ID (ciamlogin):
azure_jwk_set_uri = "https://<subdominio>.ciamlogin.com/<TENANT_ID>/discovery/v2.0/keys"
azure_authority   = "https://<subdominio>.ciamlogin.com/"

# NUNCA uses estos valores de ejemplo en un despliegue real.
db_password            = "<PASSWORD_MYSQL>"
rabbitmq_password      = "<PASSWORD_RABBITMQ>"
rabbitmq_erlang_cookie = "<COOKIE_ERLANG_UNICA_Y_SECRETA>"

enable_recovery_alarms = true

# Opcional: cuenta gratuita en duckdns.org, para que la URL del frontend
# no cambie entre sesiones del Learner Lab. Vacio = se usa la Elastic IP
# directamente. El token de DuckDNS NO va aqui: es un secret del workflow
# (DUCKDNS_TOKEN), ver infra/terraform/README.md.
duckdns_domain = ""
