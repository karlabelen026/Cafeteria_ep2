#!/bin/bash
# Generado por Terraform (infra/terraform/main.tf, aws_instance.kafka) a
# partir de este template. Se ejecuta una sola vez al primer arranque de la
# EC2 (cloud-init). Levanta el cluster Kafka (3 Zookeeper + 3 brokers + Kafka
# UI, ver deploy/aws/docker-compose.kafka.yml) y crea el servicio systemd que
# lo vuelve a levantar en cada arranque posterior (el Learner Lab detiene la
# instancia al terminar la sesion del lab).
set -euxo pipefail

APP_DIR=/opt/cafeteria

# ── Docker + plugin de compose ──────────────────────────────────────────────
apt-get update -y
apt-get install -y ca-certificates curl gnupg git

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# ── Swap de 2 GB: colchon para las 7 JVM (3 brokers, 3 Zookeeper y Kafka UI)
# en los 4 GB de una t3.medium. ───────────────────────────────────────────────
if [ ! -f /swapfile ]; then
  fallocate -l 2G /swapfile
  chmod 600 /swapfile
  mkswap /swapfile
  swapon /swapfile
  echo "/swapfile none swap sw 0 0" >> /etc/fstab
fi

# ── Repositorio (solo se usan los compose de deploy/aws) ─────────────────────
if [ ! -d "$APP_DIR/.git" ]; then
  rm -rf "$APP_DIR"
  git clone --depth 1 --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  git fetch --depth 1 origin "${repo_branch}"
  git reset --hard FETCH_HEAD
fi
chown -R ubuntu:ubuntu "$APP_DIR"

# ── .env: cada broker se anuncia con la IP privada de esta EC2, que no cambia
# al detener/iniciar la instancia. Kafka UI pide el mismo usuario y clave que
# el panel de RabbitMQ. ───────────────────────────────────────────────────────
KAFKA_HOST_IP=$(hostname -I | awk '{print $1}')
cat > "$APP_DIR/.env" <<ENV_EOF
# Generado por Terraform (infra/terraform/user_data_kafka.sh.tftpl).
KAFKA_HOST_IP=$KAFKA_HOST_IP
KAFKA_UI_USER=cafeteria
KAFKA_UI_PASSWORD=${kafka_ui_password}
ENV_EOF
chown ubuntu:ubuntu "$APP_DIR/.env"
chmod 600 "$APP_DIR/.env"

# ── Servicio systemd: levanta el cluster en cada arranque ───────────────────
cat > /etc/systemd/system/cafeteria-kafka.service <<SERVICE_EOF
[Unit]
Description=CafeGestion360 Kafka (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/docker compose -f deploy/aws/docker-compose.kafka.yml --env-file .env up -d
ExecStop=/usr/bin/docker compose -f deploy/aws/docker-compose.kafka.yml --env-file .env down
Restart=on-failure
RestartSec=30
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE_EOF

systemctl daemon-reload
systemctl enable cafeteria-kafka.service
systemctl start cafeteria-kafka.service
