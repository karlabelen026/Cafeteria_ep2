#!/bin/bash
# Generado por Terraform (infra/terraform/main.tf, aws_instance.rabbitmq) a
# partir de este template. Se ejecuta una sola vez al primer arranque de la
# EC2 (cloud-init). Levanta el cluster RabbitMQ de 3 nodos (ver
# deploy/aws/docker-compose.rabbitmq.yml) y crea el servicio systemd que lo
# vuelve a levantar en cada arranque posterior (el Learner Lab detiene la
# instancia al terminar la sesion del lab).
set -euxo pipefail

APP_DIR=/opt/cafeteria

# ── Docker + plugin de compose ──────────────────────────────────────────────
apt-get update -y
apt-get install -y ca-certificates curl gnupg git

install -m 0755 -d /etc/apt/keyrings
curl -fsSL https://download.docker.com/linux/ubuntu/gpg | gpg --dearmor -o /etc/apt/keyrings/docker.gpg
chmod a+r /etc/apt/keyrings/docker.gpg

ARCH=$(dpkg --print-architecture)
CODENAME=$(. /etc/os-release && echo "$VERSION_CODENAME")
echo "deb [arch=$ARCH signed-by=/etc/apt/keyrings/docker.gpg] https://download.docker.com/linux/ubuntu $CODENAME stable" \
  > /etc/apt/sources.list.d/docker.list

apt-get update -y
apt-get install -y docker-ce docker-ce-cli containerd.io docker-buildx-plugin docker-compose-plugin

systemctl enable docker
systemctl start docker
usermod -aG docker ubuntu

# ── Repositorio (deploy/aws y rabbitmq/rabbitmq.conf) ────────────────────────
if [ ! -d "$APP_DIR/.git" ]; then
  rm -rf "$APP_DIR"
  git clone --depth 1 --branch "${repo_branch}" "${repo_url}" "$APP_DIR"
else
  cd "$APP_DIR"
  git fetch --depth 1 origin "${repo_branch}"
  git reset --hard FETCH_HEAD
fi
chown -R ubuntu:ubuntu "$APP_DIR"

# ── .env (nunca se commitea): credenciales y cookie compartida del cluster ──
cat > "$APP_DIR/.env" <<ENV_EOF
# Generado por Terraform (infra/terraform/user_data_rabbitmq.sh.tftpl).
RABBITMQ_USER=cafeteria
RABBITMQ_PASSWORD=${rabbitmq_password}
RABBITMQ_ERLANG_COOKIE=${rabbitmq_erlang_cookie}
ENV_EOF
chown ubuntu:ubuntu "$APP_DIR/.env"
chmod 600 "$APP_DIR/.env"

# ── Servicio systemd: levanta el cluster en cada arranque ───────────────────
cat > /etc/systemd/system/cafeteria-rabbitmq.service <<SERVICE_EOF
[Unit]
Description=CafeGestion360 RabbitMQ (docker compose)
Requires=docker.service
After=docker.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
RemainAfterExit=yes
WorkingDirectory=$APP_DIR
ExecStart=/usr/bin/docker compose -f deploy/aws/docker-compose.rabbitmq.yml --env-file .env up -d
ExecStop=/usr/bin/docker compose -f deploy/aws/docker-compose.rabbitmq.yml --env-file .env down
Restart=on-failure
RestartSec=30
TimeoutStartSec=0

[Install]
WantedBy=multi-user.target
SERVICE_EOF

systemctl daemon-reload
systemctl enable cafeteria-rabbitmq.service
systemctl start cafeteria-rabbitmq.service
