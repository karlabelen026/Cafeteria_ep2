# Ejemplo del .env que cada user_data de infra/terraform escribe en la EC2
# (/opt/cafeteria/.env). Solo placeholders: NUNCA pongas valores reales aqui.
# Sirve para validar los compose de esta carpeta en local:
#   docker compose -f deploy/aws/docker-compose.apps.yml --env-file deploy/aws/.env.example config -q

# EC2 de backend
BACKEND_IMAGE=ghcr.io/<owner>/cafeteria-backend:deploy
SPRING_PROFILES_ACTIVE=
AZURE_ISSUER_URI=https://<subdominio>.ciamlogin.com/<TENANT_ID>/v2.0
AZURE_AUDIENCES=<BACKEND_CLIENT_ID>,api://<BACKEND_CLIENT_ID>
AZURE_JWK_SET_URI=
FRONTEND_ORIGIN=https://<dominio-del-frontend>
ORIGIN_VERIFY_SECRET=<SECRETO_ORIGIN_VERIFY>
INTERNAL_API_TOKEN=<TOKEN_INTERNO>
DB_PASSWORD=<PASSWORD_MYSQL>
KAFKA_BOOTSTRAP_SERVERS=10.0.0.10:9092,10.0.0.10:9093,10.0.0.10:9094
RABBITMQ_ADDRESSES=10.0.0.20:5672,10.0.0.20:5673,10.0.0.20:5674
RABBITMQ_MANAGEMENT_URL=http://10.0.0.20:15672

# EC2 de RabbitMQ (y credenciales que usa el backend)
RABBITMQ_USER=cafeteria
RABBITMQ_PASSWORD=<PASSWORD_RABBITMQ>
RABBITMQ_ERLANG_COOKIE=<COOKIE_ERLANG>

# EC2 de Kafka: IP privada con la que se anuncia cada broker y login de Kafka UI
KAFKA_HOST_IP=10.0.0.10
KAFKA_UI_USER=cafeteria
KAFKA_UI_PASSWORD=<PASSWORD_KAFKA_UI>
